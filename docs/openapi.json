    "/api/bookings/availability": {
      "get": {
        "summary": "Get Availability",
        "description": "Free/busy slots for a provider on one local calendar date, in both that\ntimezone and UTC. If the provider has a configured weekly schedule (see\nPOST /api/providers/schedule) for that weekday, its hours are used;\notherwise falls back to a fixed default window (09:00-18:00). Explicit\nstart_hour/end_hour query params always win over both.",
        "operationId": "get_availability_api_bookings_availability_get",
        "parameters": [
          {
            "name": "provider_name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Provider Name"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Date"
            }
          },
          {
            "name": "timezone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "UTC",
              "title": "Timezone"
            }
          },
          {
            "name": "slot_minutes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 60,
              "title": "Slot Minutes"
            }
          },
          {
            "name": "start_hour",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start Hour"
            }
          },
          {
            "name": "end_hour",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End Hour"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/providers/schedule": {
      "post": {
        "summary": "Set Provider Schedule",
        "description": "Configure a provider's working hours for one weekday (upsert \u2014 call\nagain with the same provider_name/weekday to change it). Used by\nGET /api/bookings/availability instead of the fixed 09:00-18:00 default\nonce set. Days without a configured schedule still use the default.",
        "operationId": "set_provider_schedule_api_providers_schedule_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
