    "/api/therapist-chat": {
      "post": {
        "summary": "Therapist Chat",
        "description": "Supportive-conversation chat backed by MentalHealthQAClassifier, separate\nfrom the legal /api/chat. Always screens for crisis signals first (keyword,\nthen the Random Forest risk classifier if the legal agent happens to be\navailable) and returns the crisis response before ever touching the Q&A\nretrieval \u2014 the dataset itself contains \"suicidal thoughts\"-labeled rows,\nso a retrieved answer must never be allowed to substitute for it.",
        "operationId": "therapist_chat_api_therapist_chat_post",
