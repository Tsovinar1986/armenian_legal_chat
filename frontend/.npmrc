# Without this, npm only *warns* on the engines mismatch in package.json and
# installs anyway -- Vite's rolldown-based bundler then crashes deep inside
# node_modules the first time `vite`/`npm run dev` actually runs (a
# SyntaxError about node:util's styleText export, which only exists on
# Node >=20.12/21.7), with nothing pointing back to "wrong Node version".
# engine-strict makes `npm install` itself fail immediately with a clear
# "Unsupported engine" message instead.
engine-strict=true
